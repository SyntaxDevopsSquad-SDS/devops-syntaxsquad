[DEFAULT]
# Ban tid: første gang 1 time, gentagne gange eskalerer automatisk
bantime        = 1h
bantime.increment = true
bantime.maxtime   = 24h
bantime.factor    = 2

# Tidsvindue hvori fejlforsøg tælles
findtime  = 10m

# Max antal fejlede forsøg før ban
maxretry  = 5

# Ignorer lokale adresser og Cloudflare IP-ranges.
# Uden dette kan fail2ban banne en Cloudflare-IP og dermed blokere AL trafik,
# da al indgående trafik proxyes igennem Cloudflare (ses i nginx-loggen som CF-IPs).
# nginx er konfigureret med real_ip_header til at gendanne rigtige IPs,
# men disse ranges er et ekstra sikkerhedsnet.
ignoreip  = 127.0.0.1/8 ::1
            173.245.48.0/20
            103.21.244.0/22
            103.22.200.0/22
            103.31.4.0/22
            141.101.64.0/18
            108.162.192.0/18
            190.93.240.0/20
            188.114.96.0/20
            197.234.240.0/22
            198.41.128.0/17
            162.158.0.0/15
            104.16.0.0/13
            104.24.0.0/14
            172.64.0.0/13
            131.0.72.0/22
            2400:cb00::/32
            2606:4700::/32
            2803:f800::/32
            2405:b500::/32
            2405:8100::/32
            2a06:98c0::/29
            2c0f:f248::/32

# Email-notifikationer (deaktiveret - vi bruger Discord via Grafana)
destemail = root@localhost
action    = %(action_)s


# ── SSH BESKYTTELSE ────────────────────────────────────────────────
[sshd]
enabled  = true
port     = ssh
filter   = sshd
logpath  = %(sshd_log)s
maxretry = 3
bantime  = 2h


# ── NGINX: for mange requests (DoS beskyttelse) ────────────────────
[nginx-limit-req]
enabled  = true
port     = http,https
filter   = nginx-limit-req
logpath  = /var/log/nginx/error.log
maxretry = 10
findtime = 1m
bantime  = 30m


# ── NGINX: scanning efter kendte exploits/bad bots ─────────────────
[nginx-botsearch]
enabled  = true
port     = http,https
filter   = nginx-botsearch
logpath  = /var/log/nginx/access.log
maxretry = 5
findtime = 1m
bantime  = 1h